# ===== 复制为 .env 使用（已列入 .gitignore，不会入库）=====
# docker compose 会自动读取同目录 .env（env_file 已配置）

# GitHub Personal Access Token（多个用英文逗号分隔）
GITHUB_TOKENS=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 可选代理
PROXY_URL=

# 数据库路径
DB_PATH=/app/data/leaked_keys.db

# ===== 安全相关 =====
# Web Dashboard 访问令牌（设置后启用 reveal / export / 推送接口）
DASHBOARD_TOKEN=
# Dashboard 监听地址；默认 127.0.0.1，改 0.0.0.0 前请务必设置 DASHBOARD_TOKEN
DASHBOARD_HOST=127.0.0.1
# 导出文件加密密钥（未设置时从 DASHBOARD_TOKEN 派生）
EXPORT_KEY=

# 数据库静态加密密钥（设置后 api_key 列存 Fernet 密文）
DB_ENCRYPTION_KEY=

# 授权声明。留空表示未确认。确认授权边界后再设为 1（CI / 容器跳过交互）。
# 不要把默认值写成 1。
SCANNER_AUTHORIZED=

# ===== 可选扫描源 =====
PASTEBIN_API_KEY=
FOFA_EMAIL=
FOFA_API_KEY=
